@@ -1,5 +1,21 @@
 import { defineTool } from '@deepseek-ai/dsh-tools';
-import { settleRun } from '@deepseek-ai/dsh-subagent';
+/* 0.2.1-rc.2 的 dsh-subagent 不再导出 settleRun；这里是 0.1.7-rc.2 实现的本地等价（等待 run.result、dispose、折叠为 outcome）。 */
+function runOutcomeLocal(result) {
+    const detail = () => (typeof result?.diagnostic === 'string' ? result.diagnostic : result?.diagnostic ? JSON.stringify(result.diagnostic) : String(result?.stopReason));
+    switch (result.stopReason) {
+        case 'completed': return { status: 'completed', result: outputValueText(Array.isArray(result.output) ? result.output : []) };
+        case 'aborted': return result.diagnostic === undefined ? { status: 'killed' } : { status: 'failed', detail: detail() };
+        default: return { status: 'failed', detail: detail() };
+    }
+}
+async function settleRun(run) {
+    let outcome;
+    try { outcome = runOutcomeLocal(await run.result); }
+    catch (error) { outcome = { status: 'failed', detail: String(error) }; }
+    try { await run.dispose(); }
+    catch (error) { return { status: 'failed', detail: `${outcome.detail === undefined ? '' : `${outcome.detail}; `}dispose failed: ${String(error)}` }; }
+    return outcome;
+}
 /** Render text blocks from the canonical JSON block array without trusting arbitrary values. */
 function outputValueText(values) {
     return values

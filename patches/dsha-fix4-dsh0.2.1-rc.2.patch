+    java.net.BindException eperm = new java.net.BindException("bind failed: EPERM (Operation not permitted)");
+    assertFalse(
+        WebPortPolicy.available(
+            40607,
+            port -> {
+              throw eperm;
+            }));
+    WebPortPolicy.Choice choice =
+        WebPortPolicy.choose(
+            0,
+            40607,
+            port ->
+                WebPortPolicy.available(
+                    port,
+                    value -> {
+                      throw eperm;
+                    }));
+    assertEquals(0, choice.listen);
+    // Non-bind I/O errors still surface; only bind failures are probe results.
+    try {
+      WebPortPolicy.available(
+          40607,
+          port -> {
+            throw new java.io.IOException("other");
+          });

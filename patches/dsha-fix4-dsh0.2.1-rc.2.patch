diff --git a/app/src/main/assets/recovery-agent.js b/app/src/main/assets/recovery-agent.js
index 890e24a..d7e4fda 100644
--- a/app/src/main/assets/recovery-agent.js
+++ b/app/src/main/assets/recovery-agent.js
@@ -94,6 +94,14 @@ export function verifyRoster(tools, scope) {
   if (JSON.stringify(names) !== JSON.stringify([...toolNames].sort()) || tools.modeFor(scope) !== 'native') throw Error('RECOVERY_TOOL_ROSTER');
   return names;
 }
+/** 单行、脱敏、最长 300 字符；只含错误名和消息，不含堆栈、令牌、密钥或本机路径之外的长标识。 */
+export function failureDetail(error, env = process.env) {
+  let text;
+  try { text = `${error?.name ?? 'Error'}: ${error?.message ?? String(error)}`; } catch { text = 'Error: unprintable'; }
+  for (const value of [env.DSHA_RECOVERY_BROKER_TOKEN, env.DEEPSEEK_API_KEY]) if (value && value.length > 3) text = text.split(value).join('***');
+  text = text.replace(/\b(Bearer|Basic)\s+\S+/gi, '$1 ***').replace(/\bsk-[A-Za-z0-9_-]{8,}/g, '***').replace(/\b[A-Fa-f0-9]{32,}\b/g, '***').replace(/[A-Za-z0-9+\/_=-]{40,}/g, '***');
+  return text.replace(/[\u0000-\u001f\u007f]+/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 300);
+}
 export function apply(ctx) {
   const instance = process.env.DSHA_RECOVERY_INSTANCE_ID;
   if (!/^[a-f0-9]{32}$/.test(instance ?? '') || !/^[1-9][0-9]*$/.test(process.env.DSHA_RECOVERY_GENERATION ?? '')) throw Error('RECOVERY_INSTANCE_ID');
@@ -116,5 +124,5 @@ export function apply(ctx) {
     await ensureRecoveryWorkspace(ctx.workspaceRegistry);
     await request('diagnostics', {}, AbortSignal.timeout(5000));
     if (!disposed) process.stdout.write(`DSHA_RECOVERY_AGENT_READY:${instance}\n`);
-  }).catch(() => { if (!disposed) process.stderr.write('DSHA_RECOVERY_AGENT_FAILED\n'); });
+  }).catch(error => { if (!disposed) process.stderr.write(`DSHA_RECOVERY_AGENT_FAILED:${failureDetail(error)}\n`); });
 }
